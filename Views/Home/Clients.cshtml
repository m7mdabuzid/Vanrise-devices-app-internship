@{
    ViewData["Title"] = "Clients";
}

<div class="phone-page" ng-app="phoneApp" ng-controller="ClientController" ng-cloak>

    <div class="phone-hero">
        <div>
            <span class="hero-badge">Client Management</span>
            <h1>Clients</h1>
            <p>Manage individual and organization clients.</p>
        </div>

        <div class="hero-stats">
            <div class="stat-card">
                <span class="stat-number">{{ clients.length }}</span>
                <span class="stat-label">Total Clients</span>
            </div>

            <div class="stat-card">
                <span class="stat-number">{{ visibleClients.length }}</span>
                <span class="stat-label">Visible Results</span>
            </div>
        </div>
    </div>

    <div class="phone-card">

        <div class="phone-card-header">
            <div>
                <h3>Client List</h3>
                <p>Filter, add, and edit client records.</p>
            </div>

            <button type="button"
                    class="btn modern-btn-success"
                    ng-click="openClientModal()">
                <span class="glyphicon glyphicon-plus"></span>
                Add Client
            </button>
        </div>

        <div class="phone-toolbar">

            <div class="search-box">
                <span class="glyphicon glyphicon-search search-icon"></span>
                <input type="text"
                       class="form-control modern-input"
                       ng-model="nameFilter"
                       placeholder="Filter by client name" />
            </div>

            <client-type-selector ng-model="typeFilter"
                                  selector-api="clientTypeFilterApi"
                                  empty-text="All Types">
            </client-type-selector>

            <div class="toolbar-buttons">
                <button type="button"
                        class="btn modern-btn-primary"
                        ng-click="applyFilter()">
                    Search
                </button>

                <button type="button"
                        class="btn modern-btn-light"
                        ng-click="clearFilter()">
                    Clear
                </button>
            </div>

        </div>

        <div class="table-responsive modern-table-wrapper">

            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Birth Date</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <tr ng-repeat="client in visibleClients track by client.id">
                        <td>
                            <span class="id-pill">#{{ client.id }}</span>
                        </td>

                        <td>
                            <strong>{{ client.name }}</strong>
                        </td>

                        <td>
                            {{ getClientTypeText(client.type) }}
                        </td>

                        <td>
                            {{ client.type === 1 ? (client.birthDate || "-") : "-" }}
                        </td>

                        <td class="action-cell">
                            <div class="action-buttons">
                                <button type="button"
                                        class="btn modern-btn-warning btn-sm"
                                        ng-click="openClientModal(client)">
                                    <span class="glyphicon glyphicon-pencil"></span>
                                    Edit
                                </button>

                                <button type="button"
                                        class="btn modern-btn-danger btn-sm"
                                        ng-click="deleteClient(client)">
                                    <span class="glyphicon glyphicon-trash"></span>
                                    Delete
                                </button>

                                <button type="button"
                                        class="btn modern-btn-success btn-sm"
                                        ng-click="openReservationModal(client, 'reserve')">
                                    Reserve
                                </button>

                                <button type="button"
                                        class="btn modern-btn-danger btn-sm"
                                        ng-if="client.hasActiveReservation"
                                        ng-click="openReservationModal(client, 'unreserve')">
                                    Unreserve
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr ng-if="visibleClients.length === 0">
                        <td colspan="5">
                            <div class="empty-state">
                                <h4>No clients found</h4>
                                <p>Try another filter value.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>

    </div>

</div>